# RestoSaaS MERN Multi-Tenancy Environment Variables
PORT=3000

# MongoDB Connection String (Local mongod or MongoDB Atlas)
# Examples:
# Local: mongodb://127.0.0.1:27017/restosaas
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/restosaas?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/restosaas

# Super Admin Default Credentials
DEFAULT_ADMIN_EMAIL=admin@restosaas.com
DEFAULT_ADMIN_PASSWORD=admin123
